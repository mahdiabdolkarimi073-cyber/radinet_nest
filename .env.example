# محیط اجرا و پورت/هاست داخلی سرویس بک‌اند در چابکان
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# رشته اتصال دیتابیس PostgreSQL در چابکان
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@POSTGRES_HOST:5432/POSTGRES_DB?schema=public

# کلید امضای توکن JWT (باید دقیقاً با JWT_SECRET سرویس فرانت‌اند یکسان باشد)
JWT_SECRET=CHANGE_ME_TO_STRONG_SHARED_SECRET

# آدرس فرانت‌اند برای CORS
FRONTEND_URL=https://radinet24.com
CORS_ORIGIN=https://radinet24.com,https://www.radinet24.com

# مسیرهای ذخیره‌سازی دائمی فایل‌ها (برای حفظ فایل‌ها در استقرارهای بعدی روی دیسک مانا)
UPLOAD_PUBLIC_DIR=./public/uploads
UPLOAD_PRIVATE_DIR=./storage/private-uploads
MAX_UPLOAD_FILE_SIZE_MB=25

